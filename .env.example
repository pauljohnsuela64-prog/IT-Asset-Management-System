DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=asset_app
DB_PASSWORD=your_password_here
DB_NAME=it_asset_management
SECRET_KEY=replace_with_a_long_random_secret_key
FLASK_DEBUG=0
# Keep the local database-name safety check. On Railway, reference MYSQLDATABASE.
DB_EXPECTED_NAME=it_asset_management
# Railway: configure MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
# as service references instead of the local DB_* variables above.
# Alternatively, configure MYSQL_URL alone plus DB_EXPECTED_NAME.
